# Copy to .env.local (never commit real values) and set the same variables in Vercel.
#
# Supabase project → Settings → API. Use ONLY the public "anon" / "publishable" key here.
# NEVER put the service_role / secret key in any VITE_ variable: VITE_ variables are bundled into
# the browser JavaScript. All write protection comes from Supabase Auth + Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: production URL used for canonical URLs, hreflang, Open Graph and the sitemap.
# Defaults to https://5chicks.vercel.app
VITE_SITE_URL=

# Optional, local development only: run the dashboard against an in-memory mock backend instead of
# Supabase (`npm run dev`). Ignored by production builds.
# VITE_CMS_MOCK=true
